# --- Base de datos (docker-compose.yml la levanta en localhost) ---
DB_PASSWORD=cambia_esto
# Puerto de la BD en tu maquina (si ya tienes un PostgreSQL en 5432, usa otro y actualiza DATABASE_URL; iniciar.ps1 lo hace solo)
# DB_PORT=5432
# Debe usar la MISMA contraseña de arriba
DATABASE_URL=postgresql+psycopg://chatbot:cambia_esto@127.0.0.1:5432/chatbot_soporte
REDIS_URL=redis://127.0.0.1:6379/0

# --- Backend ---
CORESTREAM_MOCK=true
# Horas de espera de la encuesta de resolución; vencido el plazo el ticket se cierra solo
ENCUESTA_HORAS=72
# Límite de peticiones del chat público, widget y login (en memoria, por IP). Detrás de un proxy de confianza: TRUST_PROXY_HEADERS=true
RATE_LIMIT_ENABLED=true
TRUST_PROXY_HEADERS=false
STORAGE_DIR=./storage
# Orígenes permitidos (el front corre en el puerto 3000)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
PUBLIC_CHAT_BASE_URL=http://localhost:3000/chat
# Secreto para firmar los JWT: largo y aleatorio (python -c "import secrets;print(secrets.token_urlsafe(48))")
JWT_SECRET=
JWT_HORAS=8
# Superadmin que crea seed.py (cámbiala)
SUPERADMIN_EMAIL=superadmin@alloxentric.local
SUPERADMIN_PASSWORD=

# --- Avisos por correo (opcional; sin SMTP_HOST los avisos quedan solo en la campana de la plataforma) ---
# SMTP_HOST=smtp.midominio.cl
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=alloxentric <no-reply@midominio.cl>
# --- Ingesta: background (por defecto) o celery (necesita Redis y un worker: celery -A app.celery_app worker -l info -P solo) ---
# INGESTA_BACKEND=background

# --- Modelo de lenguaje: AWS Bedrock (credenciales por perfil de AWS CLI: `aws configure --profile chatbot`; nada de claves aquí) ---
BEDROCK_HABILITADO=false
# AWS_PROFILE=chatbot
# AWS_REGION=us-east-1
# BEDROCK_MODEL_ID=us.anthropic.claude-haiku-5-5   # confirma el ID exacto en la consola de Bedrock de tu región
# Sin habilitar Bedrock el motor RAG responde con el fragmento más relevante (modo extractivo)
# EMBEDDINGS_BACKEND=sentence-transformers   # o 'hash' (sin modelo, solo pruebas)
# EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
# RAG_TOP_K=4

# Registro en autoservicio (/registro): cualquiera crea cuenta, empresa y chatbot. false = solo el superadmin crea empresas y usuarios
REGISTRO_ABIERTO=true

# --- IA: búsqueda híbrida, OCR, caché, respaldo y rate limit compartido ---
RAG_HIBRIDO=true                 # vectores + palabras clave + reordenamiento (false = solo vectores)
OCR_HABILITADO=true              # PDFs escaneados: se transcriben con visión de Bedrock (cuesta tokens; necesita BEDROCK_HABILITADO=true)
OCR_MAX_PAGINAS=15
CACHE_RESPUESTAS=true            # reutiliza la respuesta a una pregunta casi idéntica si no cambió la documentación ni la configuración
CACHE_SIM_MIN=0.93               # similitud mínima entre preguntas para reutilizar
BEDROCK_RESPALDO=nova-lite       # id del catálogo que responde si falla el modelo de la empresa (vacío = sin respaldo)
RATELIMIT_BACKEND=memory         # memory | redis (compartido entre procesos; si Redis cae, vuelve a memoria)
