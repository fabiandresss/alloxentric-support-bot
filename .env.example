# --- Base de datos (docker-compose.yml la levanta en localhost) ---
DB_PASSWORD=cambia_esto
# Debe usar la MISMA contraseña de arriba
DATABASE_URL=postgresql+psycopg://chatbot:cambia_esto@127.0.0.1:5432/chatbot_soporte
REDIS_URL=redis://127.0.0.1:6379/0

# --- Backend ---
CORESTREAM_MOCK=true
# Horas de espera de la encuesta de resolución; vencido el plazo el ticket se cierra solo
ENCUESTA_HORAS=72
STORAGE_DIR=./storage
# Orígenes permitidos (el front corre en el puerto 3000)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
PUBLIC_CHAT_BASE_URL=http://localhost:3000/chat
# Secreto para firmar los JWT: largo y aleatorio (python -c "import secrets;print(secrets.token_urlsafe(48))")
JWT_SECRET=
JWT_HORAS=8
# Superadmin que crea seed.py (cámbiala)
SUPERADMIN_EMAIL=superadmin@alloxentric.local
SUPERADMIN_PASSWORD=

# --- Modelo de lenguaje (lo usará el motor RAG de Vicente) ---
DEEPSEEK_API_KEY=
