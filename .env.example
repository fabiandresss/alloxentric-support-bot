# --- Base de datos (docker-compose.yml la levanta en localhost) ---
DB_PASSWORD=cambia_esto
# Puerto de la BD en tu maquina (si ya tienes un PostgreSQL en 5432, usa otro y actualiza DATABASE_URL; iniciar.ps1 lo hace solo)
# DB_PORT=5432
# Debe usar la MISMA contraseña de arriba
DATABASE_URL=postgresql+psycopg://chatbot:cambia_esto@127.0.0.1:5432/chatbot_soporte
REDIS_URL=redis://127.0.0.1:6379/0

# --- Backend ---
CORESTREAM_MOCK=true
# Horas de espera de la encuesta de resolución; vencido el plazo el ticket se cierra solo
ENCUESTA_HORAS=72
# Límite de peticiones del chat público, widget y login (en memoria, por IP). Detrás de un proxy de confianza: TRUST_PROXY_HEADERS=true
RATE_LIMIT_ENABLED=true
TRUST_PROXY_HEADERS=false
STORAGE_DIR=./storage
# Orígenes permitidos (el front corre en el puerto 3000)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
PUBLIC_CHAT_BASE_URL=http://localhost:3000/chat
# Secreto para firmar los JWT: largo y aleatorio (python -c "import secrets;print(secrets.token_urlsafe(48))")
JWT_SECRET=
JWT_HORAS=8
# Superadmin que crea seed.py (cámbiala)
SUPERADMIN_EMAIL=superadmin@alloxentric.local
SUPERADMIN_PASSWORD=

# --- Modelo de lenguaje (lo usará el motor RAG de Vicente) ---
DEEPSEEK_API_KEY=
# Sin clave el motor RAG responde con el fragmento más relevante (modo extractivo)
# EMBEDDINGS_BACKEND=sentence-transformers   # o 'hash' (sin modelo, solo pruebas)
# EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
# RAG_TOP_K=4
